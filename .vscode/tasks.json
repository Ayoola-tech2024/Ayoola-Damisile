{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Preview Server",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\serve.ps1",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Build Tailwind CSS",
      "type": "npm",
      "script": "build",
      "problemMatcher": ["$tsc"],
      "group": "build"
    }
  ]
}